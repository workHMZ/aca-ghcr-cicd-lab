# Azure AI Search Settings (Required)
AZURE_SEARCH_ENDPOINT=https://rg-genai-student-jp.search.windows.net
AZURE_SEARCH_INDEX_NAME=ragdocs-v4
# Index scripts (create/ingest/clear/evaluate) target; kept separate from the
# served index so a new schema version never overwrites the live one.
AZURE_SEARCH_INDEX_NAME_V4=ragdocs-v4
AZURE_SEARCH_API_KEY=your-azure-search-api-key
# Semantic reranker scores are 0-4; weaker contexts are dropped before generation.
SEARCH_MIN_RERANKER_SCORE=1.5

# OpenAI Settings (Required)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_VERBOSITY=low
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2

# Local multilingual embedding via ONNX Runtime (revision and file hashes are pinned)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_VARIANT=onnx-qint8
# Container images preload this directory and run offline. Leave unset to use
# ~/.cache/serverless-rag (downloaded and SHA-256 verified on first use).
# EMBEDDING_MODEL_PATH=/opt/models/multilingual-e5-small
EMBEDDING_BATCH_SIZE=16
EMBEDDING_THREADS=1
EMBEDDING_MAX_TOKENS=512

# Public-endpoint cost guardrails (per replica; 0 disables)
ANSWER_CACHE_TTL_SECONDS=3600
QUERY_RATE_LIMIT_PER_MINUTE=20
QUERY_DAILY_LIMIT=500

# Application / Environment Settings
ENV_NAME=stg
MAX_QUESTION_CHARS=4000
SEARCH_TOP_K_DEFAULT=5
SEARCH_TOP_K_MAX=10

# Datadog APM (opt-in; requires the Agent sidecar, see terraform enable_datadog_sidecar)
DD_TRACE_ENABLED=false
# DD_API_KEY=your-datadog-api-key
# DD_SITE=us5.datadoghq.com
# DD_ENV=stg
# DD_SERVICE=serverless-rag-api
# DD_TRACE_AGENT_URL=http://127.0.0.1:8126

# Datadog Sidecar Agent Settings (For reference when deploying manually)
# DD_APM_ENABLED=true
# DD_APM_NON_LOCAL_TRAFFIC=true
# DD_IGNORE_AUTOCONF=kubelet
# DD_HOSTNAME=serverless-rag-api
