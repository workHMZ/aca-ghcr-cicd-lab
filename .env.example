# Azure AI Search Settings (Required)
AZURE_SEARCH_ENDPOINT=https://rg-genai-student-jp.search.windows.net
AZURE_SEARCH_INDEX_NAME=ragdocs-v3
# Migration scripts intentionally use a separate target so the 2.x index is never overwritten.
AZURE_SEARCH_INDEX_NAME_V3=ragdocs-v3
AZURE_SEARCH_API_KEY=your-azure-search-api-key

# OpenAI Settings (Required)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_VERBOSITY=low
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2

# Local multilingual embedding (model revision is immutable for reproducibility)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Container images preload this directory and run offline. Leave unset for local HF cache.
# EMBEDDING_MODEL_PATH=/opt/models/multilingual-e5-small
EMBEDDING_BATCH_SIZE=16
EMBEDDING_QUERY_MAX_TOKENS=512

# Application / Environment Settings
ENV_NAME=stg
MAX_QUESTION_CHARS=4000
SEARCH_TOP_K_DEFAULT=5
SEARCH_TOP_K_MAX=10

# Datadog APM & Service Catalog Settings (App Container)
# Uncomment to trace locally
# DD_API_KEY=your-datadog-api-key
# DD_SITE=us5.datadoghq.com
# DD_ENV=stg
# DD_SERVICE=YOU-NAME
# DD_TRACE_AGENT_URL=http://127.0.0.1:8126

# Datadog Sidecar Agent Settings (For reference when deploying manually)
# DD_APM_ENABLED=true
# DD_APM_NON_LOCAL_TRAFFIC=true
# DD_IGNORE_AUTOCONF=kubelet
# DD_HOSTNAME=YOU-NAME
